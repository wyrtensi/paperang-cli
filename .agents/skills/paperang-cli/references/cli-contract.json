{
  "schema_version": "0.2.0",
  "package_version": "0.2.1",
  "project": "paperang-cli",
  "canonical_human_contract": "docs/agents/cli-contract.md",
  "contract_scope": "Documented agent-facing behavior for the matching package version. Do not infer future compatibility guarantees.",
  "stability_definitions": {
    "stable": "Supported agent-facing behavior in the documented package version.",
    "experimental": "Implemented behavior that requires manual physical-output validation and may change in later releases.",
    "internal": "Implementation detail. Agents must not rely on it."
  },
  "console_commands": [
    "paperang",
    "paperang-cli"
  ],
  "preferred_console_command": "paperang",
  "supported_models": [
    {
      "id": "paperang_p1",
      "status": "supported",
      "transport": "ble",
      "supported_live_transports": [
        "ble"
      ],
      "unsupported_live_transports": [
        "local",
        "cable",
        "usb"
      ],
      "hardware_tested_platforms": [
        "windows"
      ],
      "compatibility_checks_without_hardware_validation": [
        "linux",
        "macos"
      ],
      "notes": "For paperang_p1, live printer communication uses BLE only. Do not attempt or document a local, cable, or USB fallback. Real BLE communication and physical printing have been tested only on Windows."
    },
    {
      "id": "paperang_p2",
      "status": "supported",
      "transport": "ble",
      "supported_live_transports": [
        "ble"
      ],
      "experimental_live_transports": [
        "usb"
      ],
      "unsupported_live_transports": [
        "local",
        "cable"
      ],
      "hardware_tested_platforms": [
        "windows"
      ],
      "compatibility_checks_without_hardware_validation": [
        "linux",
        "macos"
      ],
      "notes": "For paperang_p2, the supported and physically validated live path is BLE through the FF00/A5 profile on Windows. USB remains an experimental software path and is not a supported validated live path in this repository yet. Linux and macOS CI checks do not prove live hardware compatibility."
    }
  ],
  "config_resolution": [
    "--config PATH",
    "PAPERANG_CLI_CONFIG",
    "per-user default config path",
    "built-in defaults"
  ],
  "default_config_paths": {
    "windows": "%APPDATA%\\paperang-cli\\paperang-cli.config.json",
    "linux_and_macos_with_xdg": "$XDG_CONFIG_HOME/paperang-cli/paperang-cli.config.json",
    "linux_and_macos_fallback": "~/.config/paperang-cli/paperang-cli.config.json"
  },
  "agent_style_selection_policy": {
    "scenarios_are_starting_points": true,
    "nearest_scenario_is_default_when_it_fits": true,
    "selection_order": [
      "nearest built-in scenario or shipped example as the default base when it fits the human-visible task",
      "temporary per-invocation style-json override of that base",
      "temporary style-json built from existing public controls"
    ],
    "persistent_print_defaults_update_requires_explicit_user_request": true,
    "break_long_words_requires_explicit_user_request": true,
    "whole_word_default_guidance": "Keep break_long_words false unless the user explicitly asks for character-level splitting.",
    "human_first_bias": {
      "labels_and_tags": "Prefer quick recognition, larger text, and low visual clutter; font_fit=largest-fitting is often the best starting point.",
      "notes_and_lists": "Prefer ordinary whole-word wrapping and natural reading order over aggressive fitting or character-level splitting.",
      "compose": "Prefer the layout and text sizing that best communicates the primary content at a glance."
    },
    "expected_paper_explanation": "Describe expected paper appearance in human terms and use estimated_length_mm, max_length_mm, and fits_length_limit when present.",
    "rotated_length_calibration": "For rotate-90-cw and rotate-90-ccw text and image jobs, estimated_length_mm and max_length_mm planning use printable_width_mm when available. Ordinary orientation jobs and ordinary compose continue to use advance_mm_per_px.",
    "response_language": "Answer in the user's language when clear; otherwise follow higher-priority environment instructions."
  },
  "global_options": [
    {
      "name": "--config",
      "type": "path",
      "description": "Use a specific JSON config file."
    },
    {
      "name": "--printer",
      "type": "string",
      "description": "Select a named profile from the config printers map. Keep the same value between matching dry-run and real print commands."
    },
    {
      "name": "--json",
      "type": "flag",
      "description": "Emit machine-readable JSON output.",
      "recommended_for_agents": true
    },
    {
      "name": "--debug",
      "type": "flag",
      "description": "Enable verbose diagnostic logging."
    },
    {
      "name": "--version",
      "type": "flag",
      "description": "Show the installed CLI version."
    }
  ],
  "automation_output_contract": {
    "success_envelope": {
      "status": "ok",
      "result": {}
    },
    "error_envelope": {
      "status": "error",
      "code": "CONFIG_ERROR",
      "message": "...",
      "exit_code": 2
    },
    "ignore_unknown_result_fields": true,
    "nullable_field_semantics": "Nullable result fields are emitted as null when the printer does not report a usable value.",
    "human_output_stable_for_parsing": false,
    "click_usage_error_caveat": "Click-level invocation failures, such as missing arguments, invalid choices, or a missing image file, may exit with code 2 before a command handler runs. They are not guaranteed to use the JSON error envelope even when --json is active."
  },
  "safety_policy": {
    "explicit_user_request_required_for_paper_use": true,
    "successful_matching_dry_run_required_before_real_print": true,
    "matching_dry_run_definition": "Use the same print subcommand, content, image, layout, conversion mode, font size, min-font-size, font-fit mode, font family, orientation, autofit intent, style-json payload, printer profile, and feed options as the intended real print. If config-driven styling defaults are involved, use the same active config and --printer value.",
    "report_dry_run_before_real_print": true,
    "ordinary_one_off_print_fast_path": "Run the matching print ... --dry-run, then the matching real print. The real print command performs its own discovery, connection, and required transport initialization.",
    "separate_live_readiness_commands_required_before_each_real_print": false,
    "live_ble_readiness_commands_must_run_sequentially": true,
    "live_readiness_command_use_cases": [
      "first contact with an unknown device",
      "explicit diagnostics",
      "recovery after a failed real print"
    ],
    "imperative_request_authorizes_one_matching_non_self_test_real_print": true,
    "follow_up_real_print_approval_required_when_initial_request_is_exploratory_or_ambiguous": true,
    "new_approval_required_for": [
      "parameters changed after dry-run",
      "copies",
      "retries",
      "repeated prints"
    ],
    "self_test_always_requires_specific_follow_up_approval": true,
    "safety_error_behavior": "Stop and report SAFETY_ERROR. Do not automatically add an allow flag or retry without explicit user approval.",
    "optional_parameters_do_not_bypass_safety": [
      "--font-size",
      "--min-font-size",
      "--font-fit",
      "--font-family",
      "--autofit",
      "--orientation",
      "--style-json",
      "--feed-mm",
      "--layout",
      "--mode",
      "--conversion"
    ],
    "allow_flag_with_dry_run": {
      "permitted_by_current_implementation": true,
      "paper_consumed": false,
      "printer_connection_attempted": false,
      "agent_guidance": "Omit allow flags from dry-runs to keep intent clear."
    },
    "real_print_flags": {
      "print.text": "--allow-paper-use",
      "print.paragraph": "--allow-paper-use",
      "print.image": "--allow-paper-use",
      "print.compose": "--allow-paper-use",
      "print.self-test": "--allow-large-paper-use"
    },
    "experimental_print_paths": {
      "commands": [
        "print.image",
        "print.compose"
      ],
      "manual_physical_output_validation_required_before_repeated_automation": true,
      "compose_note": "A matching compose dry-run is mandatory. A separate print image dry-run is useful for isolated image-conversion tuning but does not replace the compose dry-run."
    }
  },
  "dry_run_contract": {
    "printer_connection_attempted": false,
    "paper_consumed": false,
    "commands": {
      "print.text": {
        "validates": [
          "text rendering",
          "selected font family",
          "selected orientation",
          "bitstream preparation",
          "font size",
          "feed calculation",
          "estimated length reporting when the active style carries a length budget"
        ],
        "does_not_validate": [
          "printer connectivity",
          "printer readiness",
          "physical output"
        ]
      },
      "print.paragraph": {
        "validates": [
          "wrapped rendering",
          "selected font family",
          "selected orientation",
          "bitstream preparation",
          "font size",
          "feed calculation",
          "estimated length reporting when the active style carries a length budget"
        ],
        "does_not_validate": [
          "printer connectivity",
          "printer readiness",
          "physical output"
        ]
      },
      "print.image": {
        "validates": [
          "local image loading",
          "selected conversion",
          "selected orientation",
          "bitstream preparation",
          "feed calculation",
          "estimated length reporting and length-fit validation when configured"
        ],
        "does_not_validate": [
          "printer connectivity",
          "printer readiness",
          "physical image quality"
        ]
      },
      "print.compose": {
        "validates": [
          "wrapped text",
          "local image loading",
          "selected layout and conversion",
          "combined bitstream preparation",
          "feed calculation",
          "estimated length reporting and length-limit evaluation when configured"
        ],
        "does_not_validate": [
          "printer connectivity",
          "printer readiness",
          "physical layout quality"
        ]
      },
      "print.self-test": {
        "validates": [
          "command path",
          "high-paper warning payload"
        ],
        "does_not_validate": [
          "printer connectivity",
          "printer readiness",
          "hardware self-test state"
        ]
      }
    }
  },
