  "exit_codes": {
    "0": "success",
    "2": "config error",
    "3": "driver error",
    "4": "printer not found",
    "5": "safety error"
  },
  "exit_code_scope": "exit_codes documents project-domain errors. Click-level usage validation may also return exit code 2.",
  "recommended_agent_workflows": {
    "library_api": [
      "paperang --json api list",
      "select the relevant model entry such as paperang --json api p1 or paperang --json api p2",
      "read the supported constructor options, methods, and safety requirements for the selected model",
      "do not assume parity with paperang-p2-lib features that are not listed there"
    ],
    "readiness_unknown_device": [
      "paperang --json config show",
      "paperang --json discover",
      "paperang --json probe",
      "paperang --json battery",
      "run live BLE readiness commands sequentially, never in parallel"
    ],
    "ordinary_one_off_print": [
      "run the matching paperang --json print ... --dry-run",
      "report the dry-run result",
      "when the request already authorized one print, run the matching real print with the correct allow flag",
      "let the real print command perform its own discovery, connection, and required transport initialization",
      "if the real print fails, stop and report the error before using diagnostic commands or retrying"
    ],
    "text": [
      "choose the nearest scenario or example as a base when it fits; otherwise build a temporary style-json payload from existing public controls",
      "keep break_long_words false unless the user explicitly asks for character-level splitting",
      "paperang --json print text \"hello\" --dry-run",
      "when font-fit is largest-fitting, keep the same --font-fit, --min-font-size, and any font_size omission between dry-run and real print",
      "when using presets or structured overrides, keep the same --style-json payload between dry-run and real print",
      "report the dry-run result in human terms, including expected paper length when the result exposes it; ask for follow-up approval only if the current request was exploratory or ambiguous",
      "paperang --json print text \"hello\" --allow-paper-use"
    ],
    "paragraph": [
      "choose the nearest scenario or example as a base when it fits; otherwise build a temporary style-json payload from existing public controls",
      "keep break_long_words false unless the user explicitly asks for character-level splitting",
      "paperang --json print paragraph \"hello\" --dry-run",
      "when font-fit is largest-fitting, keep the same --font-fit, --min-font-size, and any font_size omission between dry-run and real print",
      "when using presets or structured overrides, keep the same --style-json payload between dry-run and real print",
      "report the dry-run result in human terms, including expected paper length when the result exposes it; ask for follow-up approval only if the current request was exploratory or ambiguous",
      "paperang --json print paragraph \"hello\" --allow-paper-use"
    ],
    "image": [
      "paperang --json print image \".\\sample.png\" --dry-run --mode sticker",
      "when a preset or structured override controls orientation or length fitting, use the matching --style-json payload for both dry-run and real print",
      "report experimental physical quality; ask for follow-up approval only if the current request was exploratory or ambiguous",
      "paperang --json print image \".\\sample.png\" --allow-paper-use --mode sticker",
      "request manual physical-quality validation before repeated automation"
    ],
    "compose": [
      "choose the nearest scenario or example as a base when it fits; otherwise build a temporary style-json payload from existing public controls",
      "keep break_long_words false unless the user explicitly asks for character-level splitting in the text section",
      "paperang --json print compose \"label\" \".\\sample.png\" --dry-run --mode sticker",
      "when font-fit is largest-fitting, keep the same --font-fit, --min-font-size, and any font_size omission between dry-run and real print",
      "when layout or length handling is JSON-driven, keep the same --style-json payload for both dry-run and real print",
      "report experimental physical quality and expected paper appearance in human terms; ask for follow-up approval only if the current request was exploratory or ambiguous",
      "paperang --json print compose \"label\" \".\\sample.png\" --allow-paper-use --mode sticker",
      "request manual physical-layout validation before repeated automation"
    ],
    "self_test": [
      "prefer status, battery, probe, and ordinary print dry-runs first",
      "paperang --json print self-test --dry-run",
      "warn about substantially higher paper use and request explicit self-test approval",
      "paperang --json print self-test --allow-large-paper-use"
    ]
  },
  "internal_details_not_public_contract": [
    "BLE library selection",
    "post-connect warm-up sequencing",
    "reconnect behavior for reused transport objects",
    "calibrated feed-unit conversion",
    "default printer width and density values",
    "internal driver boundaries"
  ]
